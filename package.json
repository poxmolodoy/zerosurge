{
  "name": "zerosurge",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop tracker for caffeine and energy drink freedom",
  "author": "poxmolodoy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poxmolodoy/zerosurge.git"
  },
  "homepage": "https://github.com/poxmolodoy/zerosurge#readme",
  "bugs": {
    "url": "https://github.com/poxmolodoy/zerosurge/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:offline": "node scripts/check-offline.js",
    "electron:start": "electron electron/main.cjs",
    "electron:build:portable": "tsc && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.zerosurge.desktop",
    "productName": "ZeroSurge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "legalTrademarks": "ZeroSurge"
    },
    "portable": {
      "artifactName": "ZeroSurge-1.0-Portable.exe"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
